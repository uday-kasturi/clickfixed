<group name="clickfixed,">

  <!-- Base: clickfixed events, decoded by the built-in json decoder. -->
  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="event.module">^clickfixed$</field>
    <description>clickfixed event</description>
  </rule>

  <!-- Base: clickfixed events, decoded by decoders/clickfixed_decoders.xml. -->
  <rule id="100801" level="0">
    <decoded_as>clickfixed</decoded_as>
    <description>clickfixed event</description>
  </rule>

  <!-- band "medium": verdict suspicious, score >= 0 -->
  <rule id="100810" level="7">
    <if_sid>100800, 100801</if_sid>
    <field name="clickfixed.severity.name">^medium$</field>
    <description>clickfixed medium: $(event.action) on $(host.name), score $(clickfixed.score)</description>
    <mitre>
      <id>T1204.004</id>
    </mitre>
    <group>clickfixed_medium,</group>
  </rule>

  <!-- band "high": verdict malicious, score >= 0 -->
  <rule id="100811" level="12">
    <if_sid>100800, 100801</if_sid>
