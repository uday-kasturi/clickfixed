    <mitre>
      <id>T1204.004</id>
    </mitre>
    <group>clickfixed_high,attack,</group>
  </rule>

  <!-- band "critical": verdict malicious, score >= 3 -->
  <rule id="100812" level="14">
    <if_sid>100800, 100801</if_sid>
