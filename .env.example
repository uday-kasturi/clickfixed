# clickfixed alerting secrets. Names only; placeholder values.
# Production: set these as real environment variables (systemd EnvironmentFile=, your
# secret manager, CI secrets). `clickfixed run --dotenv .env` loads a local .env for
# development only; real environment variables always take precedence.
# Only the variables referenced by ENABLED outputs are required.

# outputs.webhook "slack": Slack incoming-webhook URL (the URL is the credential)
CFX_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# outputs.webhook "generic": bearer token sent as "Authorization: Bearer <token>"
CFX_GENERIC_WEBHOOK_TOKEN=replace-me

# outputs.jira (auth = "basic"): account email and API token
CFX_JIRA_USER=soc-bot@example.com
CFX_JIRA_API_TOKEN=replace-me
